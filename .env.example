# ===== Server =====
NODE_ENV=development
PORT=7050

# The frontend origin(s) allowed to call this API from a BROWSER — comma-separated
# for more than one, no trailing slash needed. This is a hard allow-list, not a
# hint: an origin missing from it gets no Access-Control-Allow-Origin header, and
# the browser reports that as "blocked by CORS policy" with no further detail.
#
# A deployment MUST list its real frontend here. The most common production
# failure is shipping this file's localhost default, which makes every request
# from the deployed site fail while local development works perfectly:
#
#   CLIENT_URL=https://isu-academic-portal.vercel.app,https://isuapp.tayeful.com
#
# localhost and 127.0.0.1 on any port are always allowed, and requests with no
# Origin header at all (curl, the Android app) are never refused. Wildcards are
# NOT supported — each preview/deployment origin needs its own entry.
# The server logs the origins it is allowing at boot; check that first.
CLIENT_URL=http://localhost:5160

# ===== MongoDB =====
MONGODB_URI=mongodb://127.0.0.1:27017/academic-file-system
# Tests only. The suite (`npm --prefix server test`) creates and drops throwaway
# `notif_test_*` databases; leave this blank to use 127.0.0.1:27017, or set it to
# your Atlas connection string on a machine with no local MongoDB. Any database
# named here is replaced by the throwaway name, so real data is never touched.
TEST_MONGODB_URI=

# ===== Auth =====
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== File Storage =====
# Documents (pdf/doc/ppt/xls/txt/zip): local | s3
FILE_STORAGE_PROVIDER=s3
UPLOAD_DIR=uploads

# The cap on the LEGACY material upload path (Upload Material / Submit Material),
# which buffers each file in memory before storing it. It does NOT affect the
# universal upload pipeline, which streams and has its own per-category limits
# (UPLOAD_MAX_*_MB) — including the large-file uploads that get optimized.
#
# So a large file uploaded through Upload Material is refused here LONG before
# optimization is ever considered. Raise this to accept bigger material, at the
# cost of that much RAM per concurrent upload; use the streaming /api/uploads
# endpoint for files that should never be buffered.
MAX_FILE_SIZE_MB=10

# Images: imgbb (required for image uploads)
IMGBB_API_KEY=

# Uploadcare (optional) — lets the admin upload page use Uploadcare's
# File Uploader widget (drag & drop, URL import, camera, Google Drive,
# Dropbox, multi-file, previews). Files go straight from the browser to
# Uploadcare's CDN; the server only stores the resulting metadata.
# Get keys at https://uploadcare.com/dashboard/ (free tier available).
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# S3-compatible storage (used only when FILE_STORAGE_PROVIDER=s3).
# Works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public read URL, if different from S3_ENDPOINT (e.g. R2's API endpoint
# is private/signed-only — its public URL is a separate R2.dev subdomain or
# your own custom domain). Leave blank if S3_ENDPOINT itself serves objects
# publicly (e.g. a self-hosted MinIO in path-style mode).
S3_PUBLIC_URL=

# ===== Email (broadcast email + OTP/password-reset mail) =====
# smtp | resend | console (console just logs the email instead of sending —
# safe default when no provider is configured, so the app never crashes for
# lack of mail config)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Academic Portal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ===== Web Push (VAPID) — required for PWA push notifications =====
# Generate a keypair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== Firebase Cloud Messaging — the Android push channel =====
# OPTIONAL, exactly like EMAIL_PROVIDER=console and the VAPID keys above: with
# these blank, fcmService silently skips push and every in-app notification
# still works. Required only if you want pushes to reach the Android app.
#
# This is a SERVER-ONLY secret. Never put it in the Android app, and never commit
# it — it grants the ability to send messages to every install of your app.
#
# Get it from: Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key". Then either paste the whole JSON as one line here
# (best on hosts with an ephemeral filesystem, e.g. Railway/Render)...
FIREBASE_SERVICE_ACCOUNT=
# ...or point at the JSON file you downloaded (best when you control the disk).
FIREBASE_SERVICE_ACCOUNT_PATH=

# ===== Class routine reminders (cron target) =====
# The stack has no scheduler, so an external cron calls
# POST /api/internal/reminders/run every minute. That endpoint is a machine
# target with no user JWT to check, so it authenticates with this shared secret
# in the `x-reminder-secret` header — and REFUSES TO RUN AT ALL (503
# REMINDER_CRON_DISABLED) while this is blank, rather than being left open.
# Use a long random string, e.g. `openssl rand -hex 32`.
REMINDER_CRON_SECRET=

# ===== Document Generator (cover pages / generated PDFs) =====
# PDF generation runs asynchronously on a BullMQ queue, so this feature needs a
# Redis instance in addition to MongoDB. Works with Railway/Render's Redis
# add-on, Upstash, or a local `docker run -p 6379:6379 redis`.
REDIS_URL=redis://127.0.0.1:6379
# Whether this process runs the render worker. A single-service deploy leaves
# both true (the worker shares the API process); a two-service deploy sets
# PDF_WORKER_IN_PROCESS=false on the API and runs `npm --prefix server run worker`
# on the other, which is the better shape once Chromium needs its own memory.
PDF_WORKER_ENABLED=true
PDF_WORKER_IN_PROCESS=true
PDF_WORKER_CONCURRENCY=2
# Optional: use a system Chromium instead of Playwright's own download
# (`npx playwright install --with-deps chromium` installs that one).
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Generated PDFs expire after this long. Keep the S3 lifecycle rule on the
# generated-documents/ prefix in step with it.
DOCUMENT_EXPIRY_HOURS=24
DOCUMENT_MAX_PDF_MB=10
# Per-user queue guards and the download URL's lifetime.
DOCUMENT_MAX_ACTIVE_JOBS=5
DOCUMENT_MAX_JOBS_PER_DAY=20
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
DOCUMENT_GENERATE_RATE_LIMIT=10
# Optional: shown by the `university.name` field source. A template that wants
# the university name can also carry it as a static field instead.
UNIVERSITY_NAME=
# Optional: the reference design to attach to the first seeded template.
# DOCUMENT_SEED_SOURCE_PATH=./EEE & Physics Lab Experiment Cover Page.pdf

# ===== Client (Vite) =====
VITE_API_URL=http://localhost:7050/api
VITE_GA_MEASUREMENT_ID=
VITE_UPLOADCARE_PUBLIC_KEY=

# Microsoft Clarity — behaviour analytics (session recordings, heatmaps,
# click/navigation insights). Leave VITE_CLARITY_PROJECT_ID blank to disable it
# entirely; set VITE_CLARITY_ENABLED=false to switch it off for one environment.
# It starts as soon as the app loads (no consent prompt) and only ever receives
# an internal, non-sensitive identifier.
VITE_CLARITY_ENABLED=true
VITE_CLARITY_PROJECT_ID=

# ===== Public Legal & Support pages (client) =====
# These fill in the public /privacy-policy, /terms, /help and /contact pages.
# Each one is OPTIONAL: if left blank the page shows a clearly-marked
# "[CONFIG PLACEHOLDER]" chip instead of a fake value. Set them before public
# release / Google Play submission. All are read in client/src/config/site.js.
VITE_SITE_URL=
VITE_UNIVERSITY_NAME=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_LEGAL_EMAIL=
VITE_SITE_CONTACT_PHONE=
VITE_SITE_CONTACT_ADDRESS=
VITE_SUPPORT_HOURS=
VITE_SUPPORT_RESPONSE_TIME=

# ===== Universal File Upload / Processing / Optimization =====
#
# Every value below is OPTIONAL — the defaults in server/src/config/env.js are
# what a deployment gets when nothing is set here. See
# docs/FILE_UPLOAD_SYSTEM.md before changing the limits.
#
# Master switch. false bypasses the whole pipeline (uploads still work, they are
# just never optimized).
UPLOADS_ENABLED=true

# Where an upload is spooled while it streams in. Never served statically.
UPLOAD_TEMP_DIR=

# Per-category size caps in MB. A raw video is legitimately gigabytes; a scanned
# image is not — this is why the cap is per category rather than one number.
# (MAX_FILE_SIZE_MB above still bounds the LEGACY multer path and is unrelated.)
UPLOAD_MAX_IMAGE_MB=64
UPLOAD_MAX_DOCUMENT_MB=256
UPLOAD_MAX_ARCHIVE_MB=1024
UPLOAD_MAX_VIDEO_MB=4096
UPLOAD_MAX_AUDIO_MB=512
UPLOAD_MAX_OTHER_MB=256
UPLOAD_MAX_FILE_MB=256
UPLOAD_MAX_FILES=10

# Files at or above this size should use the multipart path (POST /uploads/init
# → presigned part URLs → direct to R2/S3), so the bytes never pass through Node.
UPLOAD_MULTIPART_THRESHOLD_MB=25
UPLOAD_PART_SIZE_MB=16
UPLOAD_SIGNED_URL_TTL_SECONDS=300

# Optimization switches and the keep-original rule (§22). An optimized version
# replaces the original ONLY when the saving clears BOTH floors — replacing a
# 98 MB PDF with a 94 MB one is not worth the quality risk, so it does not happen.
UPLOAD_OPTIMIZE_ENABLED=true
UPLOAD_OPTIMIZE_IMAGES=true
UPLOAD_OPTIMIZE_PDF=true
UPLOAD_OPTIMIZE_TEXT=true
UPLOAD_MIN_SAVING_BYTES=262144
UPLOAD_MIN_SAVING_PERCENT=5
UPLOAD_DERIVATIVES=true

# Image rules. maxDimension is the long-edge ceiling; anything larger is
# downscaled (never enlarged). textSafeQuality is the floor applied to an image
# that looks like a scan or a screenshot of text.
UPLOAD_IMAGE_MAX_DIMENSION=3000
UPLOAD_IMAGE_JPEG_QUALITY=82
UPLOAD_IMAGE_WEBP_QUALITY=80
UPLOAD_IMAGE_PNG_LEVEL=9
UPLOAD_IMAGE_ALLOW_WEBP=false
UPLOAD_IMAGE_TEXT_SAFE_QUALITY=90
UPLOAD_THUMB_WIDTH=320
UPLOAD_PREVIEW_WIDTH=1280

# PDF quality profiles (§6), expressed as a long-edge pixel ceiling plus a JPEG
# quality. BALANCED is the default. Only JPEG (DCTDecode) images inside a PDF are
# re-encoded; everything else — text, fonts, forms, annotations — is preserved.
UPLOAD_PDF_PROFILE=BALANCED
UPLOAD_PDF_HQ_MAX_EDGE=3500
UPLOAD_PDF_HQ_QUALITY=90
UPLOAD_PDF_BALANCED_MAX_EDGE=2200
UPLOAD_PDF_BALANCED_QUALITY=78
UPLOAD_PDF_SMALL_MAX_EDGE=1400
UPLOAD_PDF_SMALL_QUALITY=62
# pdf-lib loads a document into memory to rewrite it, so a PDF above this size is
# stored as-is rather than risking the worker's heap.
UPLOAD_PDF_MAX_MB=300
UPLOAD_PDF_MAX_IMAGES=0

# Text compression. 'auto'/'brotli'/'gzip'/'none'. NOTE: Node 22 has no built-in
# streaming zstd and the npm options are buffer-based, so zstd is not used — see
# the deviation note in docs/FILE_UPLOAD_SYSTEM.md.
UPLOAD_TEXT_CODEC=auto
UPLOAD_BROTLI_QUALITY=5
UPLOAD_TEXT_MIN_BYTES=65536
UPLOAD_TEXT_MIN_SAVING_PERCENT=10

# 'off' | 'detect' | 'dedupe'. Detection records a SHA-256 and reports duplicate
# uploads. 'dedupe' stores one physical object for identical content — deliberately
# opt-in, because it is destructive.
UPLOAD_DEDUPE_MODE=detect

# Optional malware scanner. Empty = none. Example with ClamAV installed:
#   UPLOAD_AV_COMMAND=clamdscan --no-summary --fdpass
# A non-zero "infected" exit rejects the upload; a scanner ERROR fails open
# (logged) so a broken scanner cannot block the whole portal.
UPLOAD_AV_COMMAND=

# Cleanup sweep (§20). Abandoned spool files, dead job scratch, stuck rows, and
# incomplete multipart uploads (which are billed for every part left behind).
UPLOAD_TEMP_TTL_MINUTES=120
UPLOAD_STALE_JOB_MINUTES=60
UPLOAD_CLEANUP_CRON=*/15 * * * *

# Worker topology. In-process by default (one service); set
# UPLOAD_WORKER_IN_PROCESS=false and run `npm --prefix server run worker:files`
# on a second service to keep heavy processing off the API instance.
UPLOAD_WORKER_ENABLED=true
UPLOAD_WORKER_IN_PROCESS=true
UPLOAD_WORKER_CONCURRENCY=2
UPLOAD_WORKER_ATTEMPTS=3

# Per-user throttling. maxConcurrentPerUser stops one account from filling the
# queue (and the temp disk) with simultaneous large uploads.
UPLOAD_RATE_LIMIT_PER_HOUR=60
UPLOAD_MAX_CONCURRENT_PER_USER=3
