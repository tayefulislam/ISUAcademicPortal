VITE_API_URL=http://localhost:7050/api
VITE_GA_MEASUREMENT_ID=
VITE_UPLOADCARE_PUBLIC_KEY=

# ===== Microsoft Clarity (behaviour analytics: session recordings, heatmaps) =====
# Set VITE_CLARITY_PROJECT_ID to the project ID from Clarity -> Settings ->
# Overview. Leave it blank to keep Clarity completely off (no script, no
# warning). Never commit a real project ID.
#
# Clarity starts as soon as the app loads — there is no consent prompt. It is
# an internal, non-sensitive identifier only; passwords, tokens and personal
# fields are never sent, and input content is masked.
#
# VITE_CLARITY_ENABLED=false switches Clarity off for an environment (e.g. local
# development) without removing the project ID.
VITE_CLARITY_ENABLED=true
VITE_CLARITY_PROJECT_ID=
